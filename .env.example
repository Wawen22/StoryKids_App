# Root-level .env.example — DO NOT put real secrets here.
# Copy to .env and fill in. Per-app .env.example files live under apps/ and experiments/.

# --- Azure OpenAI (image generation) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2

# --- Google Gemini (image generation, free-tier fallback) ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp-image-generation

# --- OpenRouter (text generation) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL_PAID=openai/gpt-4o-mini
OPENROUTER_TEXT_MODEL_FREE=openai/gpt-oss-120b:free

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Database (Supabase Postgres connection string) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/storykids?schema=public
DIRECT_URL=postgresql://postgres:password@localhost:5432/storykids?schema=public

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=storykids-dev
R2_PUBLIC_BASE_URL=

# --- Redis (Upstash for prod, local docker for dev) ---
REDIS_URL=redis://localhost:6379

# --- RevenueCat ---
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH_HEADER=

# --- Observability ---
SENTRY_DSN=
POSTHOG_API_KEY=
LOG_LEVEL=info

# --- App config ---
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
DAILY_SPEND_CAP_CENTS=500
