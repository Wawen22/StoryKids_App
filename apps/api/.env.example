# apps/api/.env.example — copy to apps/api/.env for local dev.
# Prefer the repo-root .env and symlink here, OR maintain both.

NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
API_HOST=0.0.0.0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/storykids?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/storykids?schema=public

SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

REDIS_URL=redis://localhost:6379

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=storykids-dev
R2_PUBLIC_BASE_URL=

AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2

GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp-image-generation

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL_PAID=openai/gpt-4o-mini
OPENROUTER_TEXT_MODEL_FREE=openai/gpt-oss-120b:free

REVENUECAT_WEBHOOK_AUTH_HEADER=

SENTRY_DSN=
POSTHOG_API_KEY=
DAILY_SPEND_CAP_CENTS=500
